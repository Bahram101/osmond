generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String?  @unique
  username  String   @unique
  fullName  String?
  password  String
  phone     String?
  avatarUrl String   @default("https://www.gravatar.com/avatar")
  role      Role     @default(MASTER)
  clientId  Int?     @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id])

  @@map("user")
}

enum Role {
  ADMIN
  MASTER
  WHOLESALER
}

model Client {
  id        Int        @id @default(autoincrement())
  fullName  String     @unique
  phone     String?
  note      String?
  type      ClientType @default(MASTER)
  createdAt DateTime   @default(now()) @map("created_at")

  user   User?   @relation
  visits Visit[]

  @@map("client")
}

enum ClientType {
  MASTER
  WALK_IN
  WHOLESALER
}

model Product {
  id             Int      @id @default(autoincrement())
  name           String
  shortName      String
  description    String?
  // code           String   @unique @db.VarChar(10)
  published      Boolean  @default(true)
  image          String?  @default("image.png")
  views          Int      @default(0)
  price          Int      @default(0)
  masterPrice    Int      @default(0)
  wholesalePrice Int      @default(0)
  quantity       Int      @default(0)
  barcode        String?  @unique
  categoryId     Int?     @map("category_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id])

  arrivals   Arrival[]
  visitItems VisitItem[]

  @@map("product")
}

model Category {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  parentId  Int?     @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children Category[] @relation("Subcategories")

  products Product[]

  @@map("category")
}

model Arrival {
  id            Int          @id @default(autoincrement())
  productId     Int
  qty           Int
  note          String?
  type          MovementType @default(IN)
  purchasePrice Decimal?     @db.Decimal(10, 2)
  createdAt     DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("arrival")
}

enum MovementType {
  IN
  OUT
}

model Visit {
  id          Int         @id @default(autoincrement())
  clientId    Int
  totalAmount Decimal     @default(0) @db.Decimal(10, 2)
  status      VisitStatus @default(OPEN)
  profit      Decimal     @default(0) @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())

  client   Client      @relation(fields: [clientId], references: [id])
  items    VisitItem[]
  payments Payment[]

  @@map("visit")
}

enum VisitStatus {
  OPEN
  PARTIAL
  PAID
}

model VisitItem {
  id           Int      @id @default(autoincrement())
  visitId      Int
  productId    Int
  quantity     Int
  price        Float
  servicePrice Decimal? @db.Decimal(10, 2)
  total        Float
  costPrice    Decimal  @default(0) @db.Decimal(10, 2)
  profit       Decimal  @default(0) @db.Decimal(10, 2)

  visit   Visit   @relation(fields: [visitId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("visit_item")
}

model Payment {
  id        Int      @id @default(autoincrement())
  visitId   Int
  amount    Float
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  visit Visit @relation(fields: [visitId], references: [id])

  @@map("payment")
}
